#!/usr/bin/env bash
# flock-map-install-root — pinned root installer for Flock Map.
#
# Invoked ONLY by /usr/local/bin/flock-map-deploy via a fixed-path sudoers
# rule; never called interactively. Owned root:root 0755 and NOT writable by
# `ubuntu`, so the delivered behaviour is fixed regardless of the payload.
#
#   flock-map-install-root <tarball>                  atomic install
#   flock-map-install-root --validate-only <tarball>  check payload, no changes
#
# Install: copy the payload to a root-only work dir (no TOCTOU on the
# ubuntu-owned stage file), re-validate independently, extract regular files
# only, read + validate VERSION, flip /apps/flock-map/current, write the nginx
# fragment (gzip, cache, and the site-wide security headers that a
# location-level add_header would otherwise drop), `nginx -t` with automatic rollback, register
# the launcher tile at the payload's VERSION, reload, prune old releases.
set -euo pipefail
umask 022

# --- BEGIN validate_payload (keep identical in flock-map-deploy and flock-map-install-root) ---
MAX_UNPACKED_BYTES=$((32 * 1024 * 1024))
validate_payload() {
  local tb="$1" listing line perms size name extra total=0 seen=" " f
  listing="$(LC_ALL=C tar --numeric-owner -tvzf "$tb" 2>/dev/null)" || { echo "error: payload is not a valid gzip tarball" >&2; return 1; }
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    # GNU tar -tv: <perms> <uid/gid> <size> <date> <time> <name>
    read -r perms _ size _ _ name extra <<<"$line"
    [[ -z "${extra:-}" ]] || { echo "error: unexpected entry: '$line'" >&2; return 1; }
    [[ "${perms:0:1}" == "-" ]] || { echo "error: '$name' is not a regular file" >&2; return 1; }
    case "$name" in index.html|cams.js|manifest.json|VERSION) ;; *) echo "error: unexpected entry '$name'" >&2; return 1;; esac
    [[ "$seen" != *" $name "* ]] || { echo "error: duplicate entry '$name'" >&2; return 1; }
    seen+="$name "
    [[ "$size" =~ ^[0-9]+$ ]] || { echo "error: bad size for '$name'" >&2; return 1; }
    total=$((total + size))
  done <<<"$listing"
  (( total <= MAX_UNPACKED_BYTES )) || { echo "error: payload too large ($total bytes)" >&2; return 1; }
  for f in index.html cams.js manifest.json VERSION; do
    [[ "$seen" == *" $f "* ]] || { echo "error: required file '$f' missing" >&2; return 1; }
  done
}
# --- END validate_payload ---

if [[ "${1:-}" == "--validate-only" ]]; then
  [[ "$#" -eq 2 && -f "$2" ]] || { echo "usage: flock-map-install-root --validate-only <tarball>" >&2; exit 2; }
  validate_payload "$2" && echo "payload ok"
  exit $?
fi

APP="flock-map"
APP_ROOT="/apps/${APP}"
RELEASES="${APP_ROOT}/releases"
RELEASE_DIR="${RELEASES}/$(date -u +%Y%m%d-%H%M%S)"
CURRENT_LINK="${APP_ROOT}/current"
DATA_DIR="${APP_ROOT}/data"
FRAGMENT_DIR="/opt/torii/nginx-fragments"
FRAGMENT_FILE="${FRAGMENT_DIR}/${APP}.conf"
BACKUP_DIR="/var/backups/flock-map"
DISPLAY_NAME="Flock Map"
DESCRIPTION="Flock Safety / ALPR camera surveillance map"
KEEP_RELEASES=5

log() { printf '==> %s\n' "$*"; }
die() { printf 'xx  %s\n' "$*" >&2; exit 1; }

[[ $EUID -eq 0 ]] || die "must run as root"
[[ "$#" -eq 1 && -f "$1" ]] || die "usage: flock-map-install-root <tarball>"

WORK="$(mktemp -d /run/flock-map-install.XXXXXX)"
trap 'rm -rf "$WORK"; rm -f "$1"' EXIT
install -m 0600 "$1" "$WORK/payload.tar.gz"
validate_payload "$WORK/payload.tar.gz" || die "payload rejected"

install -d -m 0755 "$RELEASES" "$DATA_DIR"
install -d -m 0700 "$BACKUP_DIR"
install -d -m 0755 "$RELEASE_DIR"
tar -xzf "$WORK/payload.tar.gz" -C "$RELEASE_DIR" --no-same-owner --no-same-permissions \
  -- index.html cams.js manifest.json VERSION
for f in index.html cams.js manifest.json VERSION; do
  [[ -f "$RELEASE_DIR/$f" && ! -L "$RELEASE_DIR/$f" ]] || { rm -rf "$RELEASE_DIR"; die "extracted '$f' is not a regular file"; }
done
VERSION="$(head -c 32 "$RELEASE_DIR/VERSION" | tr -d '[:space:]')"
[[ "$VERSION" =~ ^[0-9]{1,4}\.[0-9]{1,4}\.[0-9]{1,4}$ ]] || { rm -rf "$RELEASE_DIR"; die "invalid VERSION '$VERSION'"; }
chmod 0755 "$RELEASE_DIR"; chmod 0644 "$RELEASE_DIR"/*
chown -R root:www-data "$RELEASE_DIR" "$DATA_DIR"
log "release ${RELEASE_DIR} (v${VERSION})"

PREV_RELEASE="$(readlink -f "$CURRENT_LINK" 2>/dev/null || true)"
ln -sfn "$RELEASE_DIR" "${CURRENT_LINK}.new" && mv -Tf "${CURRENT_LINK}.new" "$CURRENT_LINK"
log "current -> ${RELEASE_DIR}"

install -d -m 0755 "$FRAGMENT_DIR"
HAD_FRAGMENT=0
if [[ -f "$FRAGMENT_FILE" ]]; then cp -p "$FRAGMENT_FILE" "$BACKUP_DIR/${APP}.conf.prev"; HAD_FRAGMENT=1; fi
cat > "$WORK/fragment.conf" <<'NGINX'
# /opt/torii/nginx-fragments/flock-map.conf — Flock Surveillance Map.
# Written by /usr/local/sbin/flock-map-install-root; do not edit by hand.
location /flock-map/ {
    alias /apps/flock-map/current/;
    gzip on;
    gzip_vary on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_types application/javascript application/json text/css text/plain;
    add_header Cache-Control "public, max-age=3600" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
}
location = /flock-map {
    return 301 /flock-map/;
}
location = /flock-map/index.html {
    alias /apps/flock-map/current/index.html;
    gzip on;
    gzip_vary on;
    add_header Cache-Control "no-store" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
}
location = /flock-map/VERSION {
    alias /apps/flock-map/current/VERSION;
    default_type text/plain;
    add_header Cache-Control "no-store" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
}
NGINX
install -m 0644 "$WORK/fragment.conf" "$FRAGMENT_FILE"

if ! nginx -t >/dev/null 2>"$WORK/nginx-t.log"; then
  cat "$WORK/nginx-t.log" >&2
  if [[ "$HAD_FRAGMENT" -eq 1 ]]; then install -m 0644 "$BACKUP_DIR/${APP}.conf.prev" "$FRAGMENT_FILE"; else rm -f "$FRAGMENT_FILE"; fi
  if [[ -n "$PREV_RELEASE" && -d "$PREV_RELEASE" ]]; then ln -sfn "$PREV_RELEASE" "${CURRENT_LINK}.new" && mv -Tf "${CURRENT_LINK}.new" "$CURRENT_LINK"; fi
  rm -rf "$RELEASE_DIR"
  die "nginx -t failed; fragment and release rolled back"
fi

log "registering launcher tile '${APP}' v${VERSION}"
/usr/local/bin/torii register "$APP" --display "$DISPLAY_NAME" --desc "$DESCRIPTION" --version "$VERSION"
log "reloading nginx"
/usr/local/bin/torii reload

# Prune: keep the newest KEEP_RELEASES releases, never the current one.
CUR="$(readlink -f "$CURRENT_LINK")"
find "$RELEASES" -mindepth 1 -maxdepth 1 -type d -name '[0-9]*-[0-9]*' -printf '%f\n' | sort -r \
  | tail -n +$((KEEP_RELEASES + 1)) | while IFS= read -r d; do
      [[ "$RELEASES/$d" == "$CUR" ]] || rm -rf -- "${RELEASES:?}/$d"
    done

log "done: flock-map v${VERSION} live at /flock-map/"
