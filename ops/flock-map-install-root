#!/usr/bin/env bash
# flock-map-install-root — pinned root installer for Flock Map.
#
# Invoked ONLY by /usr/local/bin/flock-map-deploy via a fixed-path sudoers
# rule; never called interactively. Takes the staged tarball path as its
# single argument and performs the atomic install.
#
# Owned root:root, mode 0755, and NOT writable by `ubuntu`, so the sudoers
# rule that pins this exact path delivers a fixed behavior regardless of
# what the deploy key sends.
set -euo pipefail

APP="flock-map"
APPS_ROOT="/apps"
DISPLAY_NAME="Flock Map"
DESCRIPTION="Flock Safety / ALPR camera surveillance map"
VERSION="1.0.0"

APP_ROOT="${APPS_ROOT}/${APP}"
RELEASE_DIR="${APP_ROOT}/releases/$(date +%Y%m%d-%H%M%S)"
CURRENT_LINK="${APP_ROOT}/current"
DATA_DIR="${APP_ROOT}/data"
FRAGMENT_FILE="/opt/torii/nginx-fragments/${APP}.conf"
BUNDLE="$1"
STAGE_DIR="/var/lib/flock-map-deploy"

log() { printf "\033[36m==>\033[0m %s\n" "$*"; }
die() { printf "\033[31mxx  %s\033[0m\n" "$*" >&2; exit 1; }

[[ $EUID -eq 0 ]] || die "must run as root"
if [[ "$(id -un)" != "root" ]]; then die "unexpected caller"; fi

[[ "$#" -eq 1 ]] || die "usage: flock-map-install-root <tarball>"
[[ -f "$BUNDLE" ]] || die "tarball not found: $BUNDLE"

# Re-validate: the caller (dispatcher) already whitelisted, but the root
# installer re-checks independently so a compromised dispatcher can't smuggle
# arbitrary files past the sudo boundary.
listing="$(tar -tzf "$BUNDLE" 2>/dev/null)" || die "invalid tarball"
for f in $listing; do
  case "$f" in
    index.html|cams.js|manifest.json) ;;
    *) die "unexpected entry in payload: '$f'";;
  esac
done
for f in index.html cams.js manifest.json; do
  grep -qxF "$f" <<<"$listing" || die "required file '$f' missing"
done

log "creating ${APP_ROOT} layout"
install -d -m 0755 "${RELEASE_DIR}" "${DATA_DIR}"

log "extracting release"
tar -xzf "$BUNDLE" -C "${RELEASE_DIR}"
chown -R root:www-data "${RELEASE_DIR}"
chown -R root:www-data "${DATA_DIR}"

log "flipping current -> ${RELEASE_DIR}"
ln -sfn "${RELEASE_DIR}" "${CURRENT_LINK}"

log "writing nginx fragment ${FRAGMENT_FILE}"
install -d -m 0755 /opt/torii/nginx-fragments
cat > "${FRAGMENT_FILE}" <<'NGINX'
# /opt/torii/nginx-fragments/flock-map.conf — Flock Surveillance Map
# Static single-page app mounted at /flock-map/.
location /flock-map/ {
    alias /apps/flock-map/current/;
    expires 1h;
    add_header Cache-Control "public, max-age=3600";
}
location = /flock-map {
    return 301 /flock-map/;
}
location = /flock-map/index.html {
    alias /apps/flock-map/current/index.html;
    add_header Cache-Control "no-store" always;
}
NGINX

log "registering '${APP}' launcher tile"
/usr/local/bin/torii register "${APP}" \
  --display "${DISPLAY_NAME}" \
  --desc "${DESCRIPTION}" \
  --version "${VERSION}"

log "reloading nginx"
/usr/local/bin/torii reload

# Remove the staged payload — never leave copies on disk.
rm -f "$BUNDLE"

log "done. open: https://chiefmonkey.art/flock-map/"